# Salin file ini menjadi ".env" lalu isi. JANGAN dibagikan atau diunggah ke tempat publik.
# File .env berada di luar folder public/, jadi tidak pernah disajikan ke pengunjung.

# --- Database (wajib) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
# Aktifkan kalau database ada di server lain dan mendukung TLS (sangat disarankan):
# DB_SSL=1
# DB_SSL_CA=/home/container/ca.pem

# --- Alamat IP pengunjung ---
# 0          = pengunjung langsung ke server ini (bawaan, header proxy diabaikan)
# 1          = ada satu proxy di depan (nginx, Pterodactyl proxy, dsb.)
# cloudflare = lewat Cloudflare (pastikan server hanya menerima trafik dari Cloudflare)
TRUST_PROXY=0

# --- Opsional ---
# Kata sandi panel (minimal 12 karakter). Kosong = dibuat acak sekali saat pertama jalan.
# ADMIN_PASS=
# Panel hanya bisa dibuka dari IP ini (pisahkan dengan koma):
# ADMIN_ALLOW_IPS=
# Origin tambahan yang boleh mengirim data ke API (jika situs diakses lewat beberapa domain):
# ALLOWED_ORIGINS=https://contoh.sch.id
# Batas permintaan per menit per IP (bawaan 600):
# RATE_GLOBAL=600
# Lama data IP/log disimpan, dalam hari (bawaan 30), dan akun chat tidak aktif dihapus setelah (bawaan 90):
# LOG_DAYS=30
# ACCOUNT_DAYS=90
